# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ OpenAI: https://platform.openai.com → API keys
OPENAI_API_KEY=
# Модель OpenAI для всех запросов
OPENAI_MODEL=gpt-6-luna
# Ваш числовой Telegram ID (узнать у @userinfobot). Остальным бот не отвечает
ALLOWED_USER_ID=
# Часовой пояс по умолчанию (потом можно менять командой /tz)
TZ=Europe/Moscow

# База данных (можно оставить как есть, но пароль лучше поменять)
POSTGRES_USER=nutri
POSTGRES_PASSWORD=change_me
POSTGRES_DB=nutri
# Строка подключения бота к базе: логин/пароль/имя должны совпадать с тремя строками выше
DATABASE_URL=postgresql+asyncpg://nutri:change_me@db:5432/nutri

# Подробность логов: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
